# Optional: copy to .env to override the development defaults (which match docker-compose.yml).
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=debug
DATABASE_URL=postgres://artifact_hub:artifact_hub@localhost:5432/artifact_hub
# Set WEB_DIST_DIR to serve a built SPA from the API (the production image does this).
# WEB_DIST_DIR=../web/dist
# Set to 1 when running behind one reverse proxy (Railway), so client IPs are correct.
TRUST_PROXY_HOPS=0
SESSION_TTL_DAYS=7
# Defaults to true in production. Set to false only when serving over plain http.
# COOKIE_SECURE=false
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_LOGIN_PER_EMAIL=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# Artifact content. Only the local driver is implemented (s3/azure are planned).
STORAGE_DRIVER=local
# Relative to apps/api in development; required in production (a mounted volume, e.g. /data/blobs).
STORAGE_LOCAL_ROOT=.data/blobs
# Largest artifact version accepted (bytes); 10 MB by default.
MAX_ARTIFACT_BYTES=10485760# AI features (natural-language search, feedback summaries). Off without an API key; the app
# works fully either way.
# AI_ENABLED=true
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL_FAST=claude-haiku-4-5-20251001
# AI_MODEL_SMART=claude-sonnet-5-5
