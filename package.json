{
  "name": "artifact-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "docker compose up -d --wait postgres && pnpm db:migrate && pnpm dev:apps",
    "dev:apps": "pnpm --filter @artifact-hub/shared build && pnpm -r --parallel dev",
    "dev:docker": "docker compose up -d --build --renew-anon-volumes",
    "dev:docker:down": "docker compose down",
    "typecheck": "pnpm --filter @artifact-hub/shared build && pnpm -r typecheck",
    "lint": "oxlint apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @artifact-hub/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter @artifact-hub/shared build && pnpm --filter @artifact-hub/api test:e2e",
    "db:migrate": "pnpm --filter @artifact-hub/shared build && pnpm --filter @artifact-hub/api db:migrate"
  },
  "devDependencies": {
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
